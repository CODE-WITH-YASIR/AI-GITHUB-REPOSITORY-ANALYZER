# ============================================================
# AI GitHub Repository Analyzer - Environment Configuration
# ============================================================

# Groq API Key (Required for LLM inference)
# Obtain a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Identifier
# Recommended: qwen/qwen3.8-27b, openai/gpt-oss-120b, or openai/gpt-oss-20b
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: GitHub Personal Access Token
# Increases GitHub API rate limit from 60 requests/hr to 5,000 requests/hr
# Generate at: https://github.com/settings/tokens (No special scopes required for public repos)
GITHUB_TOKEN=

# ChromaDB persistence directory path
CHROMA_PERSIST_DIR=./chroma_db
